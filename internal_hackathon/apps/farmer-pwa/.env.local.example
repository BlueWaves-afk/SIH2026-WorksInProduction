# Public browser configuration only. Never place SUPABASE_SERVICE_KEY here.
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional. If omitted, signup links return to the current app origin.
VITE_AUTH_REDIRECT_URL=https://sih-2026-works-in-production.vercel.app
VITE_AUTH_REQUIRED=false
VITE_DEMO_MODE=true
# When auth is enabled, the farmer gate supports phone OTP and email/password.
# Phone OTP additionally needs a Supabase SMS provider; email uses Supabase Auth.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
