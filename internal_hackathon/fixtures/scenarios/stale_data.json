{
  "scenario": "stale_data",
  "description": "Last-good weather and price feeds past their TTL",
  "days": 90,
  "signals": [
    {"source": "imd", "metric": "rainfall_deviation_pct", "value": -30, "unit": "percent", "ttl_days": 2, "age_days": 20},
    {"source": "agmarknet", "metric": "mandi_price_deviation_pct", "value": {"deviation_pct": -25, "below_msp": true}, "unit": "percent", "ttl_days": 3, "age_days": 20},
    {"source": "farmer_opt_in", "metric": "due_window", "value": {"days_to_due": 14, "amount_band": "medium"}, "unit": "days", "ttl_days": 7, "age_days": 20},
    {"source": "sentinel2", "metric": "satellite_crop_stress", "value": 12, "unit": "percent", "ttl_days": 10, "age_days": 20},
    {"source": "msp", "metric": "msp_price", "value": 7121, "unit": "inr_per_quintal", "ttl_days": 365, "age_days": 20},
    {"source": "bhuvan", "metric": "village_coordinates", "value": {"lat": 20.0, "lon": 73.8}, "unit": "geojson", "ttl_days": 30, "age_days": 20},
    {"source": "soil", "metric": "soil_water_holding_capacity", "value": "medium", "unit": "class", "ttl_days": 365, "age_days": 20}
  ]
}
