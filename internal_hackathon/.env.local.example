# Copy this file to .env.local and fill in local credentials.
# Never commit .env.local. Vercel/Render/Supabase should receive the same
# values through their encrypted environment-variable stores.
ENV=local
AUTH_REQUIRED=false
DATABASE_URL=sqlite:///./kisansetu.local.db
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Optional override. By default the backend derives this from SUPABASE_URL.
SUPABASE_JWKS_URL=
# Only needed for projects still using the legacy HS256 shared secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
VAULT_ENCRYPTION_KEY=
ADAPTER_MODE_IMD=mock
ADAPTER_MODE_AGMARKNET=mock
ADAPTER_MODE_AGRISTACK=mock
ADAPTER_MODE_BHASHINI=mock
ADAPTER_MODE_BHUVAN=mock
ADAPTER_MODE_MSP=mock
ADAPTER_MODE_SENTINEL2=mock
ADAPTER_MODE_SOIL=mock
LIVE_DATA_ENABLED=false
LIVE_ADAPTER_TIMEOUT_SECONDS=10
LIVE_SIGNAL_SOURCES=imd,agmarknet,bhuvan,msp,sentinel2,soil
IMD_ENDPOINT=
AGMARKNET_ENDPOINT=
AGRISTACK_ENDPOINT=
BHUVAN_ENDPOINT=
MSP_ENDPOINT=
SENTINEL2_ENDPOINT=
SOIL_ENDPOINT=
NOTIFY_PROVIDER=mock
SMS_PROVIDER_KEY=
BHASHINI_API_KEY=
IMD_API_KEY=
AGMARKNET_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_CALL_ENDPOINT=
WHATSAPP_CALL_API_KEY=
WHATSAPP_CALL_PROVIDER=partner
SARVAM_VOICE_AGENT_BASE_URL=https://apps.sarvam.ai
SARVAM_VOICE_AGENT_API_KEY=
SARVAM_VOICE_AGENT_ORG_ID=
SARVAM_VOICE_AGENT_WORKSPACE_ID=
SARVAM_VOICE_AGENT_APP_ID=
SARVAM_VOICE_AGENT_APP_VERSION=1
SARVAM_VOICE_AGENT_CONNECTION_ID=
SARVAM_VOICE_AGENT_PHONE_NUMBER=
NOTIFICATION_WEBHOOK_SECRET=
LLM_PROVIDER=template
LLM_MODEL=sarvam-105b-conversations
LLM_EXTERNAL_ALLOWED=false
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_STT_ENDPOINT=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_ENDPOINT=https://api.sarvam.ai/text-to-speech
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE=shubh
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://sih-2026-works-in-production.vercel.app
OBSERVATION_RETENTION_DAYS=90
OUTBOX_RETENTION_DAYS=30
