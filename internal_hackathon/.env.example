# ---- Database (M1) ----
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/platform
# ---- Auth (M2) ----
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
# Optional override. By default the backend derives this from SUPABASE_URL.
SUPABASE_JWKS_URL=
# Only needed for projects still using the legacy HS256 shared secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
VAULT_ENCRYPTION_KEY=
AUTH_REQUIRED=false
# ---- Adapters (M3): mock | real, per source ----
ADAPTER_MODE_IMD=mock
ADAPTER_MODE_AGMARKNET=mock
ADAPTER_MODE_AGRISTACK=mock
ADAPTER_MODE_BHASHINI=mock
ADAPTER_MODE_BHUVAN=mock
ADAPTER_MODE_MSP=mock
ADAPTER_MODE_SENTINEL2=mock
ADAPTER_MODE_SOIL=mock
LIVE_DATA_ENABLED=false
LIVE_ADAPTER_TIMEOUT_SECONDS=10
IMD_ENDPOINT=
AGMARKNET_ENDPOINT=
AGRISTACK_ENDPOINT=
BHASHINI_ENDPOINT=
BHUVAN_ENDPOINT=
MSP_ENDPOINT=
SENTINEL2_ENDPOINT=
SOIL_ENDPOINT=
IMD_API_KEY=
AGMARKNET_API_KEY=
BHASHINI_API_KEY=
AGRISTACK_API_KEY=
BHUVAN_API_KEY=
MSP_API_KEY=
SENTINEL2_API_KEY=
SOIL_API_KEY=
LIVE_SIGNAL_SOURCES=imd,agmarknet
# ---- Notification (M6) ----
NOTIFY_PROVIDER=mock
SMS_PROVIDER_KEY=
# ---- AI (M7) ----
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=
SHADOW_ML_ENABLED=false
# ---- App ----
ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
QUIET_HOURS_START=21
QUIET_HOURS_END=7
OUTREACH_DAILY_CAP=2
OBSERVATION_RETENTION_DAYS=90
OUTBOX_RETENTION_DAYS=30
